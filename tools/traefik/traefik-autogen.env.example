# Example configuration for import.sh
# Copy this to /etc/traefik/import.env or ./import.env and set real values.

# PVE servers: newline-separated entries in the form:
# alias|https://pve.example.com:8006/api2/json|PVEAPIToken=user@pam!token=xxxxxxxx-xxxx-xxxx
# Example (two entries):
# PVE_SERVERS_RAW=$'p1|https://pve1.example.com:8006/api2/json|PVEAPIToken=user@pam!token=abcd-1234\n'\
#                 $'p2|https://pve2.example.com:8006/api2/json|PVEAPIToken=user@pam!token=efgh-5678'
PVE_SERVERS_RAW=""

# AdGuard Home API endpoints and credentials
ADGUARD_PRIMARY="adguard-primary.example.local"
ADGUARD_SECONDARY="adguard-secondary.example.local"
ADGUARD_USER="admin"
ADGUARD_PASS="changeme"

# Optional: force a Traefik sync target IP (VIP).
# If unset, the script attempts to detect the local VIP automatically.
DEFAULT_TRAEFIK_VIP="192.168.1.100"

# Optional: enable dry run mode (true/false)
DRY_RUN=false

# Local IP mask for is_private_ip function
# Examples: 
# "192.168."  for 192.168.0.0/16
# "10."  for 10.0.0.0/8
# "192.168.0"  for "192.168.0.0/24
LAN_PREFIX="192.168."  

# ============================================================================
# GATUS MONITORING CONFIGURATION (Optional)
# ============================================================================
# Enable Gatus monitoring by providing a list of Gatus server IPs.
# If empty or unset, Gatus integration is disabled.
#
# Format: pipe-separated list of server IPs/hostnames
# Example: "192.168.0.33|192.168.2.33"
GATUS_SERVERS_RAW=""

# Gatus config directory on monitoring servers
GATUS_CONFIG_DIR="/etc/gatus/config.d"

# Filename for autogenerated Gatus config on monitoring servers
GATUS_AUTOGEN_FILE="autogen-pve.yml"

# Container name (used for docker HUP signal on reload)
# Set to empty string if using systemctl reload instead
GATUS_CONTAINER_NAME="gatus"

# SSH user for scp/ssh operations to Gatus servers
GATUS_SSH_USER="root"

# SSH password for Gatus servers (uses sshpass)
# Leave empty to use SSH key-based authentication instead
GATUS_SSH_PASS=""

# End of import.env example